# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # whisper_cpp_flutter_plus (spec 006 S14) looks up its C functions at run
  # time with DynamicLibrary.process(). Linked statically like every pod here,
  # nothing in the app calls them, so the linker would strip them ("symbol
  # not found"). `-u` keeps exactly these. The static linkage itself is
  # unchanged (the separation model's ONNX Runtime relies on it).
  whisper_symbols = %w[
    wf_benchmark wf_context_create wf_context_free wf_job_cancel wf_job_create
    wf_job_free wf_job_progress wf_job_set_double wf_job_set_int
    wf_job_set_string wf_last_error wf_model_info wf_run wf_string_free
    wf_system_info wf_tokenize wf_vad_create wf_vad_free wf_vad_is_speech
    wf_vad_reset wf_vad_segments wf_version
  ]
  keep = whisper_symbols.map { |name| "-Wl,-u,_#{name}" }.join(' ')
  installer.aggregate_targets.each do |aggregate|
    next unless aggregate.name == 'Pods-Runner'
    aggregate.xcconfigs.each_key do |variant|
      path = aggregate.client_root + aggregate.xcconfig_relative_path(variant)
      config = File.read(path)
      next if config.include?('wf_context_create')
      File.write(path, config.sub('OTHER_LDFLAGS = ', "OTHER_LDFLAGS = #{keep} "))
    end
  end
end
